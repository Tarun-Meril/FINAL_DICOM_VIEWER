{
  "name": "medview-vr",
  "private": true,
  "version": "0.1.0",
  "description": "MedView VR - standalone CT 3D volume visualization and rendering engine (R&D prototype)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:wasm": "node tools/copy-wasm.mjs",
    "dev": "npm run prepare:wasm && vite",
    "build": "npm run prepare:wasm && tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "validate:dataset": "vite-node -c vitest.config.ts tools/ingest-report.ts",
    "validate:render": "node tools/validate-render.mjs"
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "^1.2.7",
    "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.8",
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "@kitware/vtk.js": "^36.14.2",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "dicom-parser": "^1.8.21",
    "fflate": "^0.8.3",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "seedrandom": "^3.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.24.2",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
